# Copy to .env and add your OpenAI project API key locally.
# This file alone starts no paid sessions.
OPENAI_API_KEY=
# Natural-language outcome planner via Agents API. 0 restores the old local grammar.
OPENAI_AGENT_ENABLED=1
OPENAI_AGENT_MODEL=gpt-5.4-mini
# Keep low: none failed the missing-duration clarification test.
OPENAI_AGENT_REASONING=low
# Clear, standalone timer requests run locally after 700ms transcript quiet.
# 0 disables this accelerator; ambiguous requests always retain planner fallback.
OPENAI_TIMER_FAST_PATH=1

# Local transcript text only, never raw audio. Optional; owner enabled this for testing.
TELEMETRY_TRANSCRIPTS=0
# External trace export is OFF unless explicitly enabled. Never exports transcripts.
OTEL_EXPORT_ENABLED=0
# Pick a Langfuse project/region, then fill these locally to enable Langfuse export.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Or use any OTLP/HTTP protobuf backend (full signal endpoint):
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
